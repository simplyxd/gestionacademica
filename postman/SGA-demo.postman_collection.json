          ]
        },
        {
          "name": "GET Asignaturas",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{tokenAdmin}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/asignaturas?limit=20",
            "description": "Catálogo de asignaturas."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Las asignaturas respondieron 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH Modificar usuario",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{tokenAdmin}}", "type": "string" }]
            },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"telefono\": \"+56 9 5555 0199\"\n}"
            },
            "url": "{{baseUrl}}/usuarios/{{usuarioSofiaId}}",
            "description": "Cambia el teléfono de Sofía Núñez. Solo se actualizan los campos enviados. El estado no entra por esta ruta."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('La modificación respondió 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH Cambiar estado",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{tokenAdmin}}", "type": "string" }]
            },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"inactivo\"\n}"
            },
            "url": "{{baseUrl}}/usuarios/{{usuarioSofiaId}}/estado",
            "description": "Activa o desactiva a Sofía Núñez. El cuerpo solo acepta activo o inactivo, y la ruta tiene que terminar en /estado."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('El cambio de estado respondió 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('El estado quedó inactivo', function () {",
                  "    pm.expect(pm.response.json().data.estado).to.eql('inactivo');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
