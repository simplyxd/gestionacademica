# Copia este archivo como `.env` (en esta misma carpeta) y completa los valores.
# El `.env` real NUNCA se sube al repositorio; este ejemplo no lleva secretos.

# development | production (en producción CORS_ORIGIN es obligatoria)
NODE_ENV=development

# Puerto de la API (opcional, por defecto 3000)
PORT=3000

# Dirección de MongoDB: mongodb://... (local) o mongodb+srv://... (Atlas)
# Para usar transacciones debe ser un replica set: Atlas ya lo es; en local, mongod --replSet rs0, rs.initiate() y ?replicaSet=rs0
MONGO_URI=mongodb://localhost:27017/sga

# Clave para firmar los tokens: mínimo 32 caracteres. Para generar una:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Orígenes permitidos por CORS, separados por coma. Solo se necesita en producción.
# En desarrollo el proxy de Vite evita CORS. Nunca uses *.
CORS_ORIGIN=
